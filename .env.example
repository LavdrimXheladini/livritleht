# Copy to web/app/.env.local (web) and mobile/app/.env (Expo). Never commit real keys.
# The app's EXPO_PUBLIC_SUPABASE_URL: 127.0.0.1 works only in the browser preview and the iOS simulator —
# use http://10.0.2.2:54321 on the Android emulator and http://<computer's Wi-Fi address>:54321 on a phone
# (README "Sign in to the app").

# Supabase — `supabase status` prints the local values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (Dashboard → Project Settings → API Keys). WEB SERVER ONLY — never NEXT_PUBLIC_ / EXPO_PUBLIC_.
# Counts the per-IP rate limits in the database (web/app/src/lib/rate-limit.ts) and marks the website's
# calls to the `quote` function as our own server. Unset = limits counted per server instance.
SUPABASE_SECRET_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Twilio (phone OTP) — set as Supabase secrets / in supabase/.env for local auth
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_MESSAGE_SERVICE_SID=
# Movers' phone codes (phone-verification function) — Supabase secrets, or supabase/functions/.env locally.
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Test numbers with a fixed code and no message: "+38344000001=123456,+48500000001=123456". Never a real person's number.
PHONE_TEST_NUMBERS=

# Public contact address shown in the FAQ (COMPLIANCE §8 complaint channel). Web server only.
CONTACT_EMAIL=

# Address search + routes (web/app/src/lib/geo/provider.ts): unset = free OpenStreetMap services,
# "fixture" = offline test data (Playwright sets this automatically).
GEO_PROVIDER=

# Landing page prices (web/app/src/lib/route-quote.ts): unset = live "from" prices from the deployed
# `quote` function (movers' own rate cards); "sample" = the labelled sample rates (Playwright sets this).
QUOTE_SOURCE=

# Rate limits (packages/shared/src/rate-limit.ts): unset = counted in the database when
# SUPABASE_SECRET_KEY is set; "memory" = per server instance (Playwright sets this: offline tests).
RATE_LIMIT_STORE=
