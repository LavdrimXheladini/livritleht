# Copy to web/app/.env.local (web) and mobile/{customer,mover}/.env (Expo). Never commit real keys.

# Supabase — `supabase status` prints the local values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Twilio (phone OTP) — set as Supabase secrets / in supabase/.env for local auth
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_MESSAGE_SERVICE_SID=

# Public contact address shown in the FAQ (COMPLIANCE §8 complaint channel). Web server only.
CONTACT_EMAIL=

# Address search + routes (web/app/src/lib/geo/provider.ts): unset = free OpenStreetMap services,
# "fixture" = offline test data (Playwright sets this automatically).
GEO_PROVIDER=

# Landing page prices (web/app/src/lib/route-quote.ts): unset = live "from" prices from the deployed
# `quote` function (movers' own rate cards); "sample" = the labelled sample rates (Playwright sets this).
QUOTE_SOURCE=
