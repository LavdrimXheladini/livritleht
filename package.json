{
  "name": "movershub",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:app": "pnpm --filter @movershub/app start",
    "dev:web": "pnpm --filter @movershub/web dev",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "test": "turbo run test && node scripts/check-compliance-tests.mjs",
    "test:db": "supabase test db",
    "test:db:cloud": "node scripts/test-db-cloud.mjs",
    "functions:build": "node scripts/build-functions-shared.mjs",
    "functions:deploy": "node scripts/build-functions-shared.mjs && supabase functions deploy --use-api",
    "e2e": "pnpm --filter @movershub/e2e e2e",
    "e2e:visual": "pnpm --filter @movershub/e2e e2e:visual",
    "e2e:apps": "pnpm --filter @movershub/e2e e2e:apps",
    "e2e:mobile": "maestro test mobile/maestro",
    "lint": "turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "~6.0.3"
  }
}
