{
  // MoversHub in VS Code: the website and the app (design/DECISIONS.md #15) as separate folders, then
  // the code they share. Open with File → Open Workspace from File… → movershub.code-workspace.
  "folders": [
    { "name": "1 · Website (web/app)", "path": "web/app" },
    { "name": "2 · App for customers and movers (mobile/app)", "path": "mobile/app" },
    { "name": "Shared · mobile code (mobile/core)", "path": "mobile/core" },
    { "name": "Shared · packages (pricing, shared, i18n, ui)", "path": "packages" },
    { "name": "Database + server functions (supabase)", "path": "supabase" },
    { "name": "Tests · website (web/e2e)", "path": "web/e2e" },
    { "name": "MoversHub · docs, design, scripts", "path": "." }
  ],
  "settings": {
    // The last folder is the whole repo: hide what already has its own folder above.
    "files.exclude": {
      "web/app": true,
      "web/e2e": true,
      "mobile/app": true,
      "mobile/core": true,
      "packages": true,
      "supabase": true
    }
  }
}
